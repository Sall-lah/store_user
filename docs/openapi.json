                },
                "retryAfter": {
                  "type": "integer",
                  "example": 10
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected server failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
