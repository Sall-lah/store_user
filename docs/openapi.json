    "/api/users/account": {
      "delete": {
        "tags": [
          "Account Lifecycle"
        ],
        "summary": "Delete User Account",
        "description": "Executes a hard deletion of the user's account and profile data.\nPerforms synchronous gRPC pre-flight checks against `store_order` to prevent deletion if active orders exist (`PENDING_PAYMENT`, `PAID`, `PROCESSING`, `SHIPPED`).\nOn success, broadcasts a `user.deleted` event on Kafka topic `user.events`.\n",
        "security": [
          {
            "GatewayUserIdAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account successfully deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteAccountSuccessResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Account deletion blocked due to active orders in flight.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveOrderConflictResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "description": "Order verification gRPC service is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/admin/users/{id}": {
      "delete": {
        "tags": [
          "Admin User Management"
        ],
        "summary": "Admin Delete User Account",
        "description": "Forcefully deletes a target user account by UUID.\nBypasses active order pre-flight verification checks against `store_order`.\nPurges user profile and notifications, and broadcasts a `user.deleted` event on Kafka topic `user.events` with reason `admin_deletion`.\n",
        "security": [
          {
            "GatewayUserIdAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Target User UUID identifier to delete",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User account successfully deleted by admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDeleteUserSuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/admin/users/{id}/ban": {
      "post": {
        "tags": [
          "Admin User Management"
        ],
        "summary": "Admin Ban User Account",
        "description": "Forcefully bans a target user account by UUID.\nPreserves customer profile and notifications in the database for auditing and forensic investigations.\nBroadcasts a `user.banned` event on Kafka topic `user.events` with reason for `store_auth` (session revocation) and `store_order` (unpaid order cancellation).\n",
        "security": [
          {
            "GatewayUserIdAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Target User UUID identifier to ban",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminBanUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User account successfully banned by admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminBanUserSuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
