  "components": {
    "securitySchemes": {
      "GatewayUserIdAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Id",
        "description": "Injected verified User UUID supplied downstream by `store_gateway`."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "UP"
          },
          "service": {
            "type": "string",
            "example": "store_user"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "a81bc81b-dead-4e5d-abff-90865d1e13b1"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
          },
          "fullName": {
            "type": "string",
            "example": "Budi Pratama"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true,
            "example": "+628123456789"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "Jl. Sudirman No. 45, Jakarta Pusat"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-23T10:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-23T12:00:00Z"
          }
        }
      },
      "CreateProfileRequest": {
        "type": "object",
        "required": [
          "fullName"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Budi Pratama"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true,
            "example": "+628123456789"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "Jl. Sudirman No. 45, Jakarta Pusat"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Budi Pratama Updated"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+628123456789"
          },
          "address": {
            "type": "string",
            "example": "Jl. Thamrin No. 10, Jakarta Pusat"
          }
        }
      },
      "DeleteAccountRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "Switching to alternative platform"
          }
        }
      },
      "DeleteAccountSuccessResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Account successfully deleted"
          }
        }
      },
      "AdminDeleteUserSuccessResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "User account successfully deleted by admin"
          }
        }
      },
      "AdminBanUserRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "Fraudulent chargeback activity"
          }
        }
      },
      "AdminBanUserSuccessResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "User account successfully banned by admin"
          }
        }
      },
      "ActiveOrderSummary": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "example": "ord_99281"
          },
          "orderNumber": {
            "type": "string",
            "example": "ORD-2026-99281"
          },
          "status": {
            "type": "string",
            "example": "ORDER_STATUS_PROCESSING"
          },
          "totalAmount": {
            "type": "integer",
            "example": 185000
          }
        }
      },
      "ActiveOrderConflictResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "cannot delete account: 1 active order(s) in flight"
          },
          "activeOrderCount": {
            "type": "integer",
            "example": 1
          },
          "activeOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActiveOrderSummary"
            }
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "c41f7142-6e7e-4091-a1b9-7561f7e34ef6"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
          },
          "title": {
            "type": "string",
            "example": "Order Delivered"
          },
          "message": {
            "type": "string",
            "example": "Your order #ORD-2026-99281 has arrived safely."
          },
          "type": {
            "type": "string",
            "example": "ORDER_UPDATE"
          },
          "data": {
            "type": "string",
            "nullable": true,
            "example": "{\"orderId\":\"ord_99281\"}"
          },
          "isRead": {
            "type": "boolean",
            "example": false
          },
          "readAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-08-24T08:30:00Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-24T08:00:00Z"
          }
        }
      },
      "NotificationListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "totalCount": {
            "type": "integer",
            "example": 15
          },
          "unreadCount": {
            "type": "integer",
            "example": 3
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "totalPages": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "MarkAllReadResponse": {
        "type": "object",
        "properties": {
          "updatedCount": {
            "type": "integer",
            "example": 3
          },
          "message": {
            "type": "string",
            "example": "Successfully marked 3 notifications as read"
          }
        }
      },
      "DeleteNotificationSuccessResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Notification successfully deleted"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "An error occurred while processing the request"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters or payload formatting.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication identity missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Access forbidden due to insufficient role claims.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Seconds until retry is permitted."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
